# Secrets for the two functions. Locally: copy to supabase/functions/.env (git ignores it),
# fill in, and `supabase functions serve` reads it. On a hosted project: `supabase secrets set`.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_DB_URL are provided by Supabase itself.

# Stripe, TEST mode only: a restricted key (rk_test_...) with Customers: Read and
# Subscriptions: Read, and nothing else. Live keys are refused.
STRIPE_API_KEY=

# First In's Stripe price IDs, comma-separated: the member bot's STRIPE_PRICE_ID, plus any
# older First In price people may still be on. Subscriptions to other prices don't count.
STRIPE_PRICE_IDS=

# Where the app is served from, comma-separated, for CORS.
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# At least 32 random characters; pg_cron sends it to entitlement-reconcile.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=
